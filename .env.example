# Bearer secret for /api/cron/* routes (Vercel Cron sends it automatically
# when set in the project env).
CRON_SECRET=an40rs0gJthpzf4ej8tamB1e+YTdH54OT01X1MOiNXk=

# Cloudflare R2 (canonical media storage; bucket: domika-fotos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=domika-fotos
# Public custom domain of the R2 bucket; browsers load images from here.
NEXT_PUBLIC_MEDIA_BASE_URL=https://domika-fotos.tinkuai.com

# 32-byte key (base64 or hex) for encrypting stored access tokens at rest.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
